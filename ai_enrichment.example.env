# Example settings for the optional AI literature enrichment (Sprint 4).
# Copy to a file named .env in this folder (".env" is gitignored and is not
# copied into the Docker image), or set the same variables in the server
# environment. Never commit a real key, put it in JavaScript, or paste it
# into a chat or screenshot.

# Paid requests stay impossible until this is true.
AI_ENRICHMENT_ENABLED=false
ANTHROPIC_API_KEY=
# Model ID (prices for these are built in: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5).
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=low
# Required for any other model so the spending limit can be enforced (USD per million tokens).
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=
# Re-run a declined request on Anthropic's recommended fallback model (budgeted at its price).
AI_REFUSAL_FALLBACK=true

# Limits per run and per day (the run stops before a request that could cross one).
AI_MAX_COST_USD_PER_RUN=1.00
AI_MAX_COST_USD_PER_DAY=3.00
AI_MAX_ARTICLES_PER_RUN=5
AI_MAX_REQUESTS_PER_RUN=10
AI_MAX_INPUT_TOKENS_PER_RUN=60000
AI_MAX_OUTPUT_TOKENS_PER_REQUEST=4000

# Paid runs from any computer other than the server itself need this code.
# Set it before enabling AI on a public deployment.
AI_ACCESS_CODE=

# Optional: where repeated extraction results are cached (default: system temp folder).
# AI_CACHE_DIR=

# Optional NCBI contact details (requests work without them at 3 per second).
# NCBI_API_KEY=
# NCBI_EMAIL=
LITERATURE_MAX_SAMPLES=25
LITERATURE_MAX_REQUESTS=80

# Future locally hosted extraction model (see the report's extraction contract).
# LOCAL_MODEL_URL=http://127.0.0.1:8080/extract
